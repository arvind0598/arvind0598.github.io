---
import config from "../config.ts";

interface Props {
  /** Tighter spacing, for the idea pages' side panel. */
  compact?: boolean;
}

const { compact = false } = Astro.props;

const iconClasses = "text-stone-700 hover:text-stone-950 dark:text-stone-300 dark:hover:text-white";
---

<footer
  role="contentinfo"
  class:list={[
    "mx-auto flex w-full max-w-3xl items-center justify-between px-6",
    compact ? "py-6" : "pt-20 pb-10",
  ]}
>
  <div class="flex items-center gap-5">
    <a href={config.githubLink} target="_blank" aria-label="GitHub (opens in new tab)" class={iconClasses}>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
      </svg>
    </a>
    <a href={config.linkedinLink} target="_blank" aria-label="LinkedIn (opens in new tab)" class={iconClasses}>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
      </svg>
    </a>
  </div>
  <label class="flex items-center gap-2 font-mono text-sm text-stone-600 dark:text-stone-400">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </svg>
    <span class="sr-only">Theme</span>
    <select
      id="theme-select"
      class="cursor-pointer bg-transparent pr-1 text-stone-800 focus:outline-2 focus:outline-blue-500 dark:text-stone-200"
    >
      <option value="light">Light</option>
      <option value="dark">Dark</option>
      <option value="auto">System</option>
    </select>
  </label>
</footer>

<script>
  // Same "hs_theme" key the homepage's toggle and DarkMode.astro use.
  const select = document.getElementById("theme-select") as HTMLSelectElement | null;
  const apply = (value: string) => {
    const dark =
      value === "dark" ||
      (value === "auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", dark);
  };
  if (select) {
    select.value = localStorage.getItem("hs_theme") ?? "light";
    select.addEventListener("change", () => {
      localStorage.setItem("hs_theme", select.value);
      apply(select.value);
    });
  }
</script>
