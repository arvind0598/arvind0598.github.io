---
import SectionLabel from "../../components/SectionLabel.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
/// <reference types="@because-dev/astro/virtual" />
import { renderInline } from "@because-dev/core";
import { posts } from "virtual:because/data";
import { formatDate } from "../../lib/blog.ts";
---

<BlogLayout
  title="Blog · Arvind Suresh"
  description="Short ideas joined by questions."
>
  <p class="max-w-xl text-lg leading-[1.78] text-stone-700 dark:text-stone-300">
    I want to write in short ideas joined by questions, not in long articles.
    <a
      href="/blog/why-because/"
      class="text-accent dark:text-accent-dark underline decoration-1 underline-offset-4"
      >Because</a
    > is the tool I'm building to do that, and this blog is its first home. Read
    any post below as one article, or open its map of ideas.
  </p>

  <section class="mt-14">
    <SectionLabel label="Main posts" />
    <ol class="mt-2">
      {
        posts.map((post) => (
          <li class="border-t border-stone-300 py-8 first:border-t-0 dark:border-stone-700">
            <div class="flex items-baseline justify-between font-mono text-xs text-stone-500 dark:text-stone-400">
              {post.date && <span>{formatDate(post.date)}</span>}
              <span class="ml-auto">{post.ideaCount} ideas</span>
            </div>
            <h3 class="mt-2 text-3xl leading-tight text-balance">
              <a
                href={post.href}
                class="hover:text-accent dark:hover:text-accent-dark text-stone-900 dark:text-stone-100"
              >
                {post.title}
              </a>
            </h3>
            <p
              class="mt-2 max-w-xl text-lg leading-[1.78] text-stone-600 dark:text-stone-400"
              set:html={renderInline(post.teaser ?? post.summary)}
            />
            <div class="mt-3 flex items-center gap-x-6">
              {post.readHref && (
                <a
                  href={post.readHref}
                  class="text-accent dark:text-accent-dark inline-flex items-center gap-1.5 font-mono text-xs tracking-[0.12em] uppercase"
                >
                  <span class="underline decoration-1 underline-offset-4">
                    Article
                  </span>
                  <span aria-hidden="true">→</span>
                </a>
              )}
              <a
                href={post.href}
                class="text-accent dark:text-accent-dark inline-flex items-center gap-1.5 font-mono text-xs tracking-[0.12em] uppercase"
              >
                <span class="underline decoration-1 underline-offset-4">
                  Map
                </span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div
    class="flex justify-end border-t border-stone-300 pt-5 dark:border-stone-700"
  >
    <a
      href="/blog/ideas/"
      class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.12em] text-stone-500 uppercase hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
    >
      Explore all ideas <span aria-hidden="true">→</span>
    </a>
  </div>
</BlogLayout>
